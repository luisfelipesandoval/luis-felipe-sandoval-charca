rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function hasNoLinks(text) {
      return !text.matches('(?i).*(https?://|www\\.|[a-z0-9\\-]+\\.(com|net|org|pe|io|app|xyz|info|biz|me)(/|$|\\s)).*');
    }

    function hasNoProfanity(text) {
      return !text.matches('(?i).*(mierda|puta|puto|pendej|carajo|conchatumadre|huevon|imbecil|idiota|estupid|fuck|shit|bitch|asshole|cunt).*');
    }

    function isValidGuestbookComment(data) {
      return data.keys().hasAll(['authorName', 'message', 'visitorId', 'createdAt'])
        && data.keys().hasOnly(['authorName', 'message', 'visitorId', 'createdAt'])
        && data.authorName is string
        && data.authorName.size() >= 1
        && data.authorName.size() <= 60
        && hasNoLinks(data.authorName)
        && hasNoProfanity(data.authorName)
        && data.message is string
        && data.message.size() >= 1
        && data.message.size() <= 200
        && hasNoLinks(data.message)
        && isValidId(data.visitorId)
        && data.createdAt == request.time;
    }

    function isValidLeaderboardScore(data) {
      return data.keys().hasAll(['playerName', 'score', 'visitorId', 'createdAt'])
        && data.keys().hasOnly(['playerName', 'score', 'visitorId', 'createdAt'])
        && data.playerName is string
        && data.playerName.size() >= 1
        && data.playerName.size() <= 15
        && hasNoLinks(data.playerName)
        && hasNoProfanity(data.playerName)
        && data.score is int
        && data.score >= 1
        && data.score <= 150000
        && isValidId(data.visitorId)
        && data.createdAt == request.time;
    }

    match /guestbook/{commentId} {
      allow get: if isValidId(commentId);
      allow list: if request.query.limit <= 50;
      allow create: if isValidId(commentId) && isValidGuestbookComment(incoming());
      allow update: if false;
      allow delete: if false;
    }

    match /leaderboard/{scoreId} {
      allow get: if isValidId(scoreId);
      allow list: if request.query.limit <= 50;
      allow create: if isValidId(scoreId) && isValidLeaderboardScore(incoming());
      allow update: if false;
      allow delete: if false;
    }
  }
}
